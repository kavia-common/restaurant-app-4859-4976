# BackendAPI environment variables example. Copy to .env and adjust values for your environment.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
SITE_URL=http://localhost:3000

# JWT
JWT_SECRET=please-change-this
JWT_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=10

# Social Login (stubs until real integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Payments (stubs)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Notifications (FCM) stub
FCM_SERVER_KEY=

# Instagram
INSTAGRAM_ACCESS_TOKEN=

# Weather
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast

# Data store mode: memory or db (db reserved for future PostgreSQL integration)
DATASTORE=memory

# Development seeding secret (used for /api/dev/seed-admin). Do NOT enable in production.
SEED_SECRET=allow-seed-in-dev
